#!/usr/bin/env python3
"""Manage incident tickets: ticket list [--all] | show ID | close ID STATUS "note" """
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path

DIR = Path("/var/lib/wazuh-gemini-forwarder/tickets")
STATUSES = {"resolved", "false_positive"}

def load(p): return json.loads(p.read_text(encoding="utf-8"))

def save(p, t):
    st = p.stat()
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(t, indent=2, ensure_ascii=False), encoding="utf-8")
    os.chown(tmp, st.st_uid, st.st_gid)      # keep wazuh-gemini ownership
    os.chmod(tmp, st.st_mode & 0o777)
    os.replace(tmp, p)

def find(tid):
    p = DIR / f"{tid}.json"
    if not p.exists():
        sys.exit(f"No such ticket: {tid}")
    return p

def main():
    a = sys.argv[1:]
    if not a or a[0] not in {"list", "show", "close"}:
        sys.exit(__doc__)
    if os.geteuid() != 0:
        sys.exit("Run with sudo")
    if a[0] == "list":
        show_all = "--all" in a
        for p in sorted(DIR.glob("INC-*.json")):
            t = load(p)
            if show_all or t.get("status") == "open":
                print(f'{t["ticket_id"]}  {t["status"]:<15} {t["severity"]:<8} '
                      f'{t["risk_score"]:>3}  {len(t["events"])} event(s)  {t["file_path"]}')
    elif a[0] == "show":
        print(json.dumps(load(find(a[1])), indent=2, ensure_ascii=False))
    else:
        if len(a) < 4 or a[2] not in STATUSES:
            sys.exit(f'Usage: ticket close ID {"|".join(sorted(STATUSES))} "note"')
        p = find(a[1]); t = load(p)
        if t.get("status") != "open":
            sys.exit(f'{a[1]} is already {t["status"]}')
        t.update({
            "status": a[2],
            "closed_at": datetime.now(timezone.utc).isoformat(),
            "closed_by": os.environ.get("SUDO_USER", "root"),
            "resolution_note": " ".join(a[3:]),
        })
        t["updated_at"] = t["closed_at"]
        save(p, t)
        print(f'Closed {a[1]} as {a[2]}')

main()
